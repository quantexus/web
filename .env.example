# Copy to .env.local
# cp .env.example .env.local

# gRPC address of the running engine (server-side only — no NEXT_PUBLIC_ prefix)
# Run `make dev-up` in the engine repo to start the engine and its dependencies.
ENGINE_GRPC_URL=localhost:50051

# NATS server URL for real-time trade and order book streams (server-side only)
NATS_URL=nats://localhost:4222

# Symbol traded on this engine instance (e.g. BTCUSD, ETHUSD)
ENGINE_SYMBOL=BTCUSD

# Asset labels shown in the UI — set to whatever the engine was configured with
ENGINE_BASE_ASSET=BTC
ENGINE_QUOTE_ASSET=USD
